# /etc/embed/env (mode 600, owner root)
EMBED_TOKEN=<random 32+ bytes, shared with nas and roll>
EMBED_THREADS=4
EMBED_PORT=8000
# EMBED_VISION=cpu forces the CPU path
OTEL_EXPORTER_OTLP_ENDPOINT=https://sensorium.zyx.tw
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<sensorium project token>
OTEL_SERVICE_NAME=embed
